{
  "name": "mizan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run check && next build",
    "start": "next start",
    "check": "npm run lint && npm run typecheck",
    "lint": "biome lint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:spec && npm run test:auth",
    "test:spec": "node --test test/calculation-spec.examples.test.mjs",
    "test:auth": "node --experimental-strip-types --test test/auth/*.test.mts",
    "test:e2e": "playwright test",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.8.3"
  }
}
