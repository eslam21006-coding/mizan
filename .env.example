# Browser/server Supabase connection. Publishable values are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted server-only Supabase key. Never expose or commit a real value.
SUPABASE_SECRET_KEY=

# Canonical application URL used for invitation redirects, e.g. https://mizan.example.com
MIZAN_SITE_URL=

# Used only by `npm run bootstrap:admin` to create/promote the first administrator.
MIZAN_ADMIN_EMAIL=
